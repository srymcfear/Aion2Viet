<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="10.0.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\dps_core_src\AionDpsMeter.Core\AionDpsMeter.Core.csproj" />
    <ProjectReference Include="..\dps_core_src\AionDpsMeter.Services\AionDpsMeter.Services.csproj" />
  </ItemGroup>

  <!-- Copy GameData JSON Assets from Core -->
  <ItemGroup>
    <None Include="..\dps_core_src\AionDpsMeter.Core\GameData\Assets\**\*.json">
      <Link>GameData\Assets\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
